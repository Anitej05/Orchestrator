# =============================================================================
# REQUIRED - Core LLM APIs (At least one is required)
# =============================================================================
CEREBRAS_API_KEY=your_cerebras_api_key_here                           # Primary LLM (optional)
CEREBRAS_API_KEYS=key1,key2,key3                                      # Multiple Cerebras keys (comma-separated)
GROQ_API_KEY=your_groq_api_key_here                                   # Fallback LLM (recommended)
GOOGLE_API_KEY=your_google_api_key_here                               # Google API
NVIDIA_API_KEY=your_nvidia_api_key_here                               # NVIDIA API (optional)
OLLAMA_API_KEYS=key1,key2                                             # Multiple Ollama keys (comma-separated)
OLLAMA_BASE_URL=https://ollama.com/v1                                 # Ollama endpoint

# =============================================================================
# REQUIRED - Database Configuration
# =============================================================================
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_HOST=localhost
PG_PORT=5432
DB_NAME=agentdb
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/agentdb

# =============================================================================
# REQUIRED - Authentication (Clerk)
# =============================================================================
# Get these from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_AUDIENCE=your_jwt_audience

# =============================================================================
# OPTIONAL - Klavis AI Integration
# =============================================================================
KLAVIS_API_KEY=your_klavis_api_key_here
KLAVIS_OAUTH_CLIENT_ID=your_oauth_client_id_here
KLAVIS_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# =============================================================================
# REQUIRED - Security
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# =============================================================================
# OPTIONAL - Additional LLM Providers
# =============================================================================
OLLAMA_API_KEY=your_ollama_api_key_here      # Local/Remote LLM option

# =============================================================================
# OPTIONAL - Frontend Configuration
# =============================================================================
FRONTEND_URL=http://localhost:3000           # Frontend URL for OAuth redirects

# =============================================================================
# OPTIONAL - Email Integration (Composio/Gmail)
# =============================================================================
COMPOSIO_API_KEY=your_composio_api_key_here
GMAIL_CONNECTION_ID=conn_xxx
GMAIL_MCP_URL=https://mcp.composio.dev/gmail/sse
# Optional but recommended for Composio manual tool execution.
# Find the current toolkit version on the official toolkit docs page, e.g. /toolkits/gmail
COMPOSIO_TOOLKIT_VERSION_GMAIL=20260211_00

# Composio Auth Configs (for multi-user OAuth)
# Get auth config IDs from Composio Dashboard: https://app.composio.dev
# Format: COMPOSIO_AUTH_CONFIG_<APP_SLUG_UPPERCASE>
COMPOSIO_AUTH_CONFIG_GMAIL=ac_gmail_xxx
COMPOSIO_AUTH_CONFIG_ZOHOBOOKS=ac_zohobooks_xxx  # Use 'zohobooks' (normalized)
COMPOSIO_AUTH_CONFIG_GITHUB=ac_github_xxx
COMPOSIO_AUTH_CONFIG_SLACK=ac_slack_xxx
COMPOSIO_AUTH_CONFIG_NOTION=ac_notion_xxx

# Connection ID Encryption (for secure storage)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=your_fernet_key_here

# =============================================================================
# OPTIONAL - Agent-specific API Keys
# =============================================================================
NEWS_API_KEY=your_news_api_key_here
SCHOLARAI_API_KEY=your_scholarai_api_key_here

# =============================================================================
# OPTIONAL - Twilio Integration
# =============================================================================
TWILIO_API_KEY_SID=your_twilio_api_key_sid_here
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here

# =============================================================================
# OPTIONAL - Environment Settings
# =============================================================================
TF_ENABLE_ONEDNN_OPTS=0                      # Disable TensorFlow optimizations
DOC_AGENT_FORCE_REBUILD=1                    # Force rebuild of document agent
SKIP_AGENTS=agent1,agent2                    # Skip specific agents on startup (comma-separated)
