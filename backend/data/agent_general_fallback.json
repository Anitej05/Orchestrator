{
  "id": "general-fallback-agent",
  "owner_id": "orbimesh-vendor",
  "name": "General Fallback Agent",
  "description": "Universal agent for Composio-powered integrations (Slack, Notion, GitHub, Linear, Jira, Asana, Trello, Figma, and 100+ other apps). Automatically discovers and executes tools based on user connections.",
  "agent_type": "http_rest",
  "version": "1.0.0",
  
  "capabilities": {
    "categories": ["communication", "productivity", "project-management", "development", "design", "fallback"],
    "all_keywords": [
      "slack",
      "notion",
      "github",
      "linear",
      "jira",
      "asana",
      "trello",
      "figma",
      "discord",
      "hubspot",
      "salesforce",
      "zendesk",
      "intercom",
      "composio",
      "integration",
      "messaging",
      "project",
      "issue",
      "task",
      "wiki",
      "document",
      "repository",
      "code",
      "design",
      "collaboration"
    ]
  },
  
  "status": "active",
  "price_per_call_usd": 0.01,
  
  "requires_credentials": false,
  "credential_fields": [],
  
  "connection_config": {
    "base_url": "http://localhost:8085",
    "timeout": 30,
    "headers": {
      "Content-Type": "application/json"
    },
    "retry_config": {
      "max_retries": 3,
      "backoff_factor": 2
    }
  },
  
  "endpoints": [
    {
      "endpoint": "/execute",
      "http_method": "POST",
      "description": "Execute any Composio-supported integration action. Automatically detects app from prompt and checks user connections.",
      "request_format": "json",
      "parameters": [
        {
          "name": "prompt",
          "param_type": "string",
          "required": true,
          "description": "Natural language instruction (e.g., 'Send a Slack message to #general saying Hello')"
        },
        {
          "name": "payload",
          "param_type": "object",
          "required": true,
          "description": "Must contain 'user_id' for connection checking. Optional: additional structured parameters."
        },
        {
          "name": "task_id",
          "param_type": "string",
          "required": false,
          "description": "Task ID for multi-turn operations"
        },
        {
          "name": "thread_id",
          "param_type": "string",
          "required": false,
          "description": "Thread ID for session context"
        }
      ]
    },
    {
      "endpoint": "/health",
      "http_method": "GET",
      "description": "Health check endpoint",
      "request_format": "none",
      "parameters": []
    }
  ],
  
  "metadata": {
    "tags": ["fallback", "composio", "universal", "integration"],
    "documentation_url": "https://docs.orbimesh.com/agents/general-fallback",
    "supported_apps": [
      "Slack",
      "Notion",
      "GitHub",
      "Linear",
      "Jira",
      "Asana",
      "Trello",
      "Figma",
      "Discord",
      "HubSpot",
      "Salesforce",
      "Zendesk",
      "Intercom",
      "And 100+ more Composio apps"
    ],
    "features": [
      "Dynamic tool discovery",
      "Connection checking",
      "User prompting for missing connections",
      "Tool caching (5-minute TTL)",
      "Automatic app detection from prompt",
      "Full UAP compliance",
      "Graceful error handling"
    ]
  }
}
