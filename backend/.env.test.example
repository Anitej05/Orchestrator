# =============================================================================
# Test Environment Configuration
# =============================================================================
# This file contains environment variables required for running integration tests.
# Copy this file to .env.test and fill in your test credentials.

# =============================================================================
# REQUIRED - Composio API Key
# =============================================================================
# Get your API key from: https://app.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here

# =============================================================================
# REQUIRED - Test User Credentials
# =============================================================================
# Test user entity ID in Composio (used for isolated testing)
# Create a dedicated test entity in Composio Dashboard to avoid affecting production data
COMPOSIO_TEST_USER_ID=test_user_orbimesh_ci

# Test connection ID for pre-connected Gmail account
# After connecting Gmail for your test user, get the connection ID from Composio Dashboard
COMPOSIO_TEST_CONNECTION_ID=conn_xxx

# =============================================================================
# OPTIONAL - Database Configuration (for integration tests)
# =============================================================================
# Use a separate test database to avoid affecting development data
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_HOST=localhost
PG_PORT=5432
DB_NAME=agentdb_test

# =============================================================================
# OPTIONAL - Connection Encryption (for testing encrypted storage)
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=your_fernet_key_here

# =============================================================================
# OPTIONAL - LLM API Keys (if tests require LLM functionality)
# =============================================================================
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# CI/CD Configuration
# =============================================================================
# For GitHub Actions, set these as repository secrets:
# - COMPOSIO_API_KEY
# - COMPOSIO_TEST_USER_ID
# - COMPOSIO_TEST_CONNECTION_ID
#
# Example GitHub Actions workflow:
# env:
#   COMPOSIO_API_KEY: ${{ secrets.COMPOSIO_API_KEY }}
#   COMPOSIO_TEST_USER_ID: ${{ secrets.COMPOSIO_TEST_USER_ID }}
#   COMPOSIO_TEST_CONNECTION_ID: ${{ secrets.COMPOSIO_TEST_CONNECTION_ID }}
