# Frontend environment template (copy to .env.local and fill in your keys)

# Backend API - CRITICAL for deployment
# For local development: defaults to http://localhost:8000 if not set
# For production (Azure/cloud): MUST be set to your backend URL (e.g., https://your-backend.azurewebsites.net)
# WebSocket URLs are automatically derived from this (http→ws, https→wss)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk Authentication - Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_your_clerk_key_here
CLERK_SECRET_KEY=sk_your_clerk_secret_here
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=jwt-template-chats
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Clerk Auth Flow URLs (Optional - defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Deployment Notes:
# 1. Copy this file to .env.local for local development
# 2. In Azure/cloud, set these as environment variables in your hosting service
# 3. Never commit .env.local to git (it's in .gitignore)
# 4. NEXT_PUBLIC_API_URL is the most critical var for deployment - without it, frontend will only work on localhost
